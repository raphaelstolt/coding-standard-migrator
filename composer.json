{
    "name": "stolt/coding-standard-migrator",
    "description": "A CLI tool and library which migrates a PHP coding-standard configuration to a Mago based one.",
    "keywords": [
        "coding-standard",
        "php-cs-fixer",
        "mago",
        "migration",
        "console",
        "pint",
        "php-codesniffer"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Raphael Stolt",
            "email": "raphael.stolt@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-simplexml": "*",
        "symfony/console": "^6.4 || ^7.0"
    },
    "require-dev": {
        "carthage-software/mago": "^1.48.1",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "stolt/lean-package-validator": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Stolt\\CodingStandardMigrator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stolt\\CodingStandardMigrator\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/cs-migrator"
    ],
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test-with-coverage": "phpunit --coverage-html coverage-reports",
        "static-analysis": "phpstan analyse --ansi",
        "validate-gitattributes": "./vendor/bin/lean-package-validator validate",
        "cs-lint": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": "mago format",
        "ci": [
            "@cs-lint",
            "@static-analysis",
            "@test",
            "@validate-gitattributes"
        ]
    },
    "scripts-descriptions": {
        "test": "Runs the test suite.",
        "test-with-coverage": "Runs the test suite and creates an HTML coverage report.",
        "static-analysis": "Runs a static analysis on the source code.",
        "cs-lint": "Checks the code for coding-standard violations.",
        "cs-fix": "Fixes the coding-standard violations which can be fixed automatically.",
        "ci": "Runs all checks which are also run in CI.",
        "validate-gitattributes": "Validates the .gitattributes file."
    }
}
