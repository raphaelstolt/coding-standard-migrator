#!/usr/bin/env php
<?php

declare(strict_types=1);

use Stolt\CodingStandardMigrator\Console\Application;

foreach ([__DIR__ . '/../../../autoload.php', __DIR__ . '/../vendor/autoload.php'] as $autoload) {
    if (\is_file($autoload)) {
        require $autoload;

        break;
    }
}

if (!\class_exists(Application::class)) {
    \fwrite(
        \STDERR,
        'Unable to find the Composer autoloader, run `composer install` first.' . \PHP_EOL,
    );

    exit(1);
}

exit((new Application())->run());
